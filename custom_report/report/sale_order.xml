  /* Primary / $green */
  .text-c { color: #198754 !important; } /* Odoo/Bootstrap's standard success/green */
  .text-c { color: #198754 !important; }
  .text-gray{color:#444 !important; line-height:1.5 !important;}
  /* Green shades (Bootstrap 5 palette) */
  .text-c-100 { color: #d1e7dd !important; }
  .text-c-200 { color: #badbcc !important; }
  .text-c-300 { color: #a3cfbb !important; }
  .text-c-400 { color: #8cc19f !important; }
  .text-c-500 { color: #198754 !important; } /* Same as $green */
  .text-c-600 { color: #146c43 !important; }
  .text-c-700 { color: #0f5132 !important; }
  .text-c-800 { color: #0a3622 !important; }
  .text-c-900 { color: #051b11 !important; }
        .bg-c-100 { background-color: #d1e7dd !important; }
        .bg-c-200 { background-color: #badbcc !important; }
        .bg-c-300 { background-color: #a3cfbb !important; }
        .bg-c-400 { background-color: #8cc19f !important; }
        .bg-c-500 { background-color: #198754 !important; } /* Same as $green */
        .bg-c-600 { background-color: #146c43 !important; }
        .bg-c-700 { background-color: #0f5132 !important; }
        .bg-c-800 { background-color: #0a3622 !important; }
        .bg-c-900 { background-color: #051b11 !important; }



.pill-border{
  border-radius: 100px !important;
}
.border_20{
  border-radius: 20px !important;
}
.border_10{
  border-radius: 10px !important;
}
.border_5{
  border-radius: 5px !important;
}
.product-table {
    width: 100%;
    table-layout: fixed;
    border: 0 !important;
    border-collapse: separate !important;
    border-spacing: 0 !important;
}

.product-table th,
.product-table td {
    text-align: center;
    vertical-align: middle;
    padding: 8px 6px;
    border: 0 !important;
}

.product-table th + th,
.product-table td + td {
    border-left: 1px solid #badbcc !important;
}

.product-table tbody tr + tr td {
    border-top: 1px solid #badbcc !important;
}

.product-table tbody tr:first-child td {
    border-top: 1px solid #badbcc !important;
}

.product-table th {
    background-color: #d1e7dd !important;
    color: #0f5132 !important;
    font-weight: 700;
}
  
</style>
    <t t-set="header_title">
        <t t-set="is_proforma" t-value="env.context.get('proforma', False) or is_pro_forma"/>
        <span t-if="is_proforma">Pro-Forma Invoice</span>
        <span t-elif="doc.state in ['draft','sent']">Quotation</span>
        <span t-else="">Sale <span class="text-c-600 ">Order</span></span>
    </t>
    <t t-call="custom_report.custom_header_report"/>


  <div class='continer mb-5'>

        <div class="row">
            <div class="col">
                <span class="text-c-600" >From :</span>
                <div class="text-c-700 fw-bold fs-4">
                 <t t-esc="doc.company_id.name"/>
                </div>
                <div class="text-gray fs-6 ">
                    <span t-esc="doc.company_id.street"/> , <span t-esc="doc.company_id.street2"/> <br/>
                    <span t-esc="doc.company_id.city"/>,<span t-esc="doc.company_id.state_id.name"/>,<span t-esc="doc.company_id.zip"/><br/>
                    <span t-esc="doc.company_id.country_id.name"/> 
                </div>
            </div>

                      <div class="col">
              <span class="text-c-600" >  To :</span>
                <div class="text-c-700 fw-bold fs-4">
                 <t t-esc="doc.partner_id.name"/>
                </div>
                <div class="text-gray fs-6 ">
                    <span t-esc="doc.partner_id.street"/> , <span t-esc="doc.partner_id.street2"/> <br/>
                    <span t-esc="doc.partner_id.city"/>,<span t-esc="doc.partner_id.state_id.name"/>,<span t-esc="doc.partner_id.zip"/><br/>
                    <span t-esc="doc.partner_id.country_id.name"/> 
                </div>
                <p t-if="doc.partner_id.vat" class="mb-0 text-gray">
                    <t t-if="doc.company_id.account_fiscal_country_id.vat_label" t-out="doc.company_id.account_fiscal_country_id.vat_label"/>
                    <t t-else="">Tax ID</t>: <span t-field="doc.partner_id.vat"/>
                </p>
            </div>
        
        </div>
      </div>



        <t t-if="doc.partner_shipping_id == doc.partner_invoice_id and doc.partner_invoice_id !=doc.partner_id or doc.partner_shipping_id != doc.partner_invoice_id">
