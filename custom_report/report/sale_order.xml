<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="sale_report_custom_change"
              inherit_id="sale.report_saleorder_document">

        <xpath expr="//t[@t-call='web.external_layout']" position="replace">

            <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
            <t t-set="is_proforma" t-value="env.context.get('proforma', False) or is_pro_forma"/>

            <t t-call="web.basic_layout">

                <style>
                    /* =========================================================
                       PDF-safe quotation theme
                       ========================================================= */

                    .quotation-page {
                        position: relative;
                        min-height: 980px;
                        padding: 22px 28px 70px 28px;
                        overflow: hidden;
                        font-family: Arial, Helvetica, sans-serif;
                        color: #1f2933;
                        background: #ffffff;
                    }

                    .q-green-900 { color: #063d2d !important; }
                    .q-green-800 { color: #0a513d !important; }
                    .q-green-700 { color: #0f684d !important; }
                    .q-green-600 { color: #198754 !important; }
                    .q-gray      { color: #4b5563 !important; }

                    .q-top-curve {
                        position: absolute;
                        top: 0;
                        right: 0;
                        width: 355px;
                        height: 150px;
                        z-index: 0;
                    }

                    .q-bottom-curve {
                        position: absolute;
                        left: 0;
                        bottom: 0;
                        width: 300px;
                        height: 105px;
                        z-index: 0;
                    }

                    .q-content {
                        position: relative;
                        z-index: 2;
                    }

                    /* Header uses no HTML table, so Odoo table styles cannot add a border */
                    .q-header-box {
                        position: relative;
                        width: 100%;
                        height: 62px;
                        margin-bottom: 18px;
                        border: none !important;
                        outline: none !important;
                        box-shadow: none !important;
                        background: transparent !important;
                    }

                    .q-header-left {
                        position: absolute;
                        left: 0;
                        top: 2px;
                        width: 34%;
                        border: none !important;
                    }

                    .q-header-center {
                        position: absolute;
                        left: 34%;
                        top: 0;
                        width: 32%;
                        height: 62px;
                        text-align: center;
                        border: none !important;
                    }

                    .q-header-right {
                        position: absolute;
                        right: 0;
                        top: 0;
                        width: 34%;
                        height: 62px;
                        border: none !important;
                    }

                    .q-title {
                        font-size: 31px;
                        line-height: 1;
                        font-weight: 800;
                        letter-spacing: .3px;
                        color: #063d2d;
                        text-transform: uppercase;
                    }

                    .q-title-mark {
                        width: 76px;
                        height: 4px;
                        margin-top: 10px;
                        background: #0f684d;
                        border-radius: 4px;
                    }

                    .q-logo {
                        max-height: 58px;
                        max-width: 190px;
                    }

                    .q-company {
                        position: relative;
                        z-index: 3;
                        text-align: right;
                        font-size: 19px;
                        line-height: 58px;
                        font-weight: 700;
                        color: #ffffff;
                        padding-right: 6px;
                        border: none !important;
                    }

                    .q-rule {
                        height: 2px;
                        background: #0f684d;
                        margin: 0 0 24px 0;
                    }

                    .q-party-table {
                        width: 100%;
                        table-layout: fixed;
                        border-collapse: separate;
                        border-spacing: 0;
                        margin-bottom: 23px;
                    }

                    .q-party-table td {
                        width: 50%;
                        vertical-align: top;
                        border: 0;
                        padding: 0 22px 0 0;
                    }

                    .q-party-table td + td {
                        padding-left: 22px;
                        padding-right: 0;
                    }

                    .q-party-label {
                        color: #0f684d;
                        font-size: 13px;
                        font-weight: 700;
                        margin-bottom: 6px;
                    }

                    .q-party-name {
                        color: #063d2d;
                        font-size: 20px;
                        font-weight: 800;
                        margin-bottom: 7px;
                    }

                    .q-party-detail {
                        font-size: 13px;
                        line-height: 1.55;
                        color: #4b5563;
                    }

                    .q-meta {
                        width: 100%;
                        table-layout: fixed;
                        border-collapse: separate;
                        border-spacing: 0;
                        margin: 6px 0 22px 0;
                        background: #d9eee5;
                        border: 1px solid #b7d9ca;
                        border-radius: 10px;
                        overflow: hidden;
                    }

                    .q-meta td {
                        width: 33.333%;
                        vertical-align: middle;
                        padding: 14px 18px;
                        border: 0;
                    }

                    .q-meta td + td {
                        border-left: 1px solid #8dbda8;
                    }

                    .q-meta-label {
                        color: #198754;
                        font-size: 12px;
                        font-weight: 700;
                        margin-bottom: 4px;
                    }

                    .q-meta-value {
                        color: #0f684d;
                        font-size: 15px;
                        font-weight: 800;
                    }

                    .q-total-value {
                        color: #063d2d;
                        font-size: 25px;
                        font-weight: 800;
                        line-height: 1.1;
                    }

                    .q-products {
                        width: 100%;
                        table-layout: fixed;
                        border-collapse: separate !important;
                        border-spacing: 0 !important;
                        border: 1px solid #b7d9ca;
                        border-radius: 9px;
                        overflow: hidden;
                        margin-top: 0;
                    }

                    .q-products th,
                    .q-products td {
                        text-align: center;
                        vertical-align: middle;
                        border: 0;
                        padding: 10px 7px;
                        font-size: 12px;
                    }

                    .q-products th {
                        background: #0f684d;
                        color: #ffffff;
                        font-size: 12px;
                        font-weight: 700;
                    }

                    .q-products th + th,
                    .q-products td + td {
                        border-left: 1px solid #c5ded3;
                    }

                    .q-products tbody tr + tr td {
                        border-top: 1px solid #d9e9e2;
                    }

                    .q-products tbody tr:nth-child(even) td {
                        background: #f7fbf9;
                    }

                    .q-products .product-name {
                        text-align: left;
                        padding-left: 14px;
                        font-weight: 700;
                        color: #263238;
                    }

                    .q-products .amount {
                        font-weight: 700;
                        color: #263238;
                    }

                    .q-footer {
                        margin-top: 22px;
                        padding-top: 12px;
                        border-top: 1px solid #d6e6df;
                        text-align: center;
                    }

                    .q-footer-title {
                        color: #0f684d;
                        font-size: 14px;
                        font-weight: 800;
                    }

                    .q-footer-text {
                        margin-top: 3px;
                        color: #667085;
                        font-size: 11px;
                    }

                    .q-note {
                        margin-top: 16px;
                        padding: 11px 13px;
                        border-left: 4px solid #198754;
                        background: #f1f8f5;
                        color: #4b5563;
                        font-size: 11px;
                        line-height: 1.5;
                    }

                    /* Avoid Bootstrap spacing inconsistencies in wkhtmltopdf */
                    .q-no-break {
                        page-break-inside: avoid;
                    }
                </style>

                <div class="quotation-page">


                    <div class="q-content">

                        <!-- Header: DIV based, avoids inherited table borders -->
                        <div class="q-header-box">
                            <div class="q-header-left">
                                <div class="q-title">
                                    <span t-if="is_proforma">Pro-Forma Invoice</span>
                                    <span t-elif="doc.state in ['draft', 'sent']">Quotation</span>
                                    <span t-else="">Sale Order</span>
                                </div>
                                <div class="q-title-mark"></div>
                            </div>

                            <div class="q-header-center">
                                <img t-if="doc.company_id.logo"
                                     t-att-src="image_data_uri(doc.company_id.logo)"
                                     class="q-logo"/>
                            </div>

                            <div class="q-header-right">
                                <div class="q-company">
                                    <t t-esc="doc.company_id.name"/>
                                </div>
                            </div>
                        </div>

                        <div class="q-rule"/>

                        <!-- From / To -->
                        <table class="q-party-table q-no-break">
                            <tr>
                                <td>
                                    <div class="q-party-label">From :</div>
                                    <div class="q-party-name">
                                        <t t-esc="doc.company_id.name"/>
                                    </div>
                                    <div class="q-party-detail">
                                        <t t-if="doc.company_id.street">
                                            <span t-esc="doc.company_id.street"/>
                                        </t>
                                        <t t-if="doc.company_id.street2">
                                            <span>, </span><span t-esc="doc.company_id.street2"/>
                                        </t>
                                        <br t-if="doc.company_id.street or doc.company_id.street2"/>

                                        <t t-if="doc.company_id.city">
                                            <span t-esc="doc.company_id.city"/>
                                        </t>
                                        <t t-if="doc.company_id.state_id">
                                            <span>, </span><span t-esc="doc.company_id.state_id.name"/>
                                        </t>
                                        <t t-if="doc.company_id.zip">
                                            <span>, </span><span t-esc="doc.company_id.zip"/>
                                        </t>
                                        <br t-if="doc.company_id.city or doc.company_id.state_id or doc.company_id.zip"/>

                                        <span t-if="doc.company_id.country_id"
                                              t-esc="doc.company_id.country_id.name"/>
                                    </div>
                                </td>

                                <td>
                                    <div class="q-party-label">To :</div>
                                    <div class="q-party-name">
                                        <t t-esc="doc.partner_id.name"/>
                                    </div>
                                    <div class="q-party-detail">
                                        <t t-if="doc.partner_id.street">
                                            <span t-esc="doc.partner_id.street"/>
                                        </t>
                                        <t t-if="doc.partner_id.street2">
                                            <span>, </span><span t-esc="doc.partner_id.street2"/>
                                        </t>
                                        <br t-if="doc.partner_id.street or doc.partner_id.street2"/>

                                        <t t-if="doc.partner_id.city">
                                            <span t-esc="doc.partner_id.city"/>
                                        </t>
                                        <t t-if="doc.partner_id.state_id">
                                            <span>, </span><span t-esc="doc.partner_id.state_id.name"/>
                                        </t>
                                        <t t-if="doc.partner_id.zip">
                                            <span>, </span><span t-esc="doc.partner_id.zip"/>
                                        </t>
                                        <br t-if="doc.partner_id.city or doc.partner_id.state_id or doc.partner_id.zip"/>

                                        <span t-if="doc.partner_id.country_id"
                                              t-esc="doc.partner_id.country_id.name"/>

                                        <t t-if="doc.partner_id.vat">
                                            <br/>
                                            <strong>
                                                <t t-if="doc.company_id.account_fiscal_country_id.vat_label"
                                                   t-out="doc.company_id.account_fiscal_country_id.vat_label"/>
                                                <t t-else="">Tax ID</t>
                                            </strong>
                                            <span>: </span>
                                            <span t-field="doc.partner_id.vat"/>
                                        </t>
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <!-- Summary -->
                        <table class="q-meta q-no-break">
                            <tr>
                                <td>
                                    <div class="q-meta-label">Your Reference</div>
                                    <div class="q-meta-value" t-field="doc.name"/>
                                </td>

                                <td>
                                    <div class="q-meta-label">Order Date</div>
                                    <div class="q-meta-value"
                                         t-esc="doc.date_order.strftime('%Y/%m/%d')"/>
                                </td>

                                <td>
                                    <div class="q-meta-label">GRAND TOTAL</div>
                                    <div class="q-total-value" t-field="doc.amount_total"/>
                                </td>
                            </tr>
                        </table>

                        <!-- Product lines -->
                        <table class="q-products">
                            <thead>
                                <tr>
                                    <th style="width: 7%;">#</th>
                                    <th style="width: 33%;">Product</th>
                                    <th style="width: 15%;">Quantity</th>
                                    <th style="width: 15%;">UoM</th>
                                    <th style="width: 15%;">Price</th>
                                    <th style="width: 15%;">Total</th>
                                </tr>
                            </thead>

                            <tbody>
                                <t t-foreach="doc.order_line" t-as="line">
                                    <tr t-if="not line.display_type">
                                        <td>
                                            <t t-esc="line_index + 1"/>
                                        </td>

                                        <td class="product-name">
                                            <span t-field="line.name"/>
                                        </td>

                                        <td>
                                            <span t-field="line.product_uom_qty"/>
                                        </td>

                                        <td>
                                            <span t-field="line.product_uom_id"/>
                                        </td>

                                        <td>
                                            <span t-field="line.price_unit"/>
                                        </td>

                                        <td class="amount">
                                            <span t-field="line.price_subtotal"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- Optional terms -->
                        <div t-if="doc.note" class="q-note q-no-break">
                            <strong>Terms &amp; Notes</strong>
                            <div t-field="doc.note"/>
                        </div>

                        <!-- Footer -->
                        <div class="q-footer q-no-break">
                            <div class="q-footer-title">Thank you for your business!</div>
                            <div class="q-footer-text">
                                We appreciate the opportunity to provide this quotation.
                            </div>
                        </div>

                    </div>
                </div>

            </t>
        </xpath>

    </template>

</odoo>
